 "phrases": {
  "s1": [
   {
    "s": 0.0,
    "e": 2.6,
    "text": "You can buy a business making ₹1 Cr a year",
    "key": "₹1 Cr",
    "hold": 2.725
   },
   {
    "s": 2.725,
    "e": 4.075,
    "text": "for just ₹27 L",
    "key": "₹27 L",
    "hold": 4.575
   },
   {
    "s": 4.575,
    "e": 5.525,
    "text": "Let me explain",
    "key": null,
    "hold": 5.975
   }
  ],
  "s2": [
   {
    "s": 5.975,
    "e": 7.3,
    "text": "Let's say there's a bakery",
    "key": "bakery",
    "hold": 7.775
   },
   {
    "s": 7.775,
    "e": 9.5,
    "text": "It makes ₹1 Cr a year in sales",
    "key": "₹1 Cr",
    "hold": 10.0
   },
   {
    "s": 10.0,
    "e": 11.675,
    "text": "One day, the owner says he's selling",
    "key": "selling",
    "hold": 12.125
   }
  ],
  "s3": [
   {
    "s": 12.125,
    "e": 13.025,
    "text": "You think, okay,",
    "key": null,
    "hold": 13.15
   },
   {
    "s": 13.15,
    "e": 13.95,
    "text": "₹1 Cr business,",
    "key": "₹1 Cr",
    "hold": 14.0
   },
   {
    "s": 14.0,
    "e": 15.525,
    "text": "so I need ₹1 Cr to buy it",
    "key": "₹1 Cr",
    "hold": 16.05
   },
   {
    "s": 16.05,
    "e": 16.525,
    "text": "Wrong.",
    "key": "Wrong",
    "hold": 16.975
   }
  ],
  "s4": [
   {
    "s": 16.975,
    "e": 19.125,
    "text": "That ₹1 Cr isn't what he takes home",
    "key": "₹1 Cr",
    "hold": 19.625
   },
   {
    "s": 19.625,
    "e": 21.75,
    "text": "Staff, ingredients, rent, electricity",
    "key": "electricity",
    "hold": 22.3
   },
   {
    "s": 22.3,
    "e": 23.725,
    "text": "After all of it, the bakery keeps",
    "key": null,
    "hold": 23.775
   },
   {
    "s": 23.775,
    "e": 25.825,
    "text": "₹15 L a year in operating profit",
    "key": "₹15 L",
    "hold": 26.275
   }
  ],
  "s5": [
   {
    "s": 26.275,
    "e": 27.15,
    "text": "Here's the thing",
    "key": "thing",
    "hold": 27.65
   },
   {
    "s": 27.65,
    "e": 28.875,
    "text": "You're not buying sales",
    "key": "sales",
    "hold": 29.375
   },
   {
    "s": 29.375,
    "e": 31.25,
    "text": "You're buying its ability to make money",
    "key": "money",
    "hold": 31.725
   },
   {
    "s": 31.725,
    "e": 33.175,
    "text": "Pay 3 times that profit,",
    "key": "3 times",
    "hold": 33.275
   },
   {
    "s": 33.275,
    "e": 34.55,
    "text": "and it's ₹45 L",
    "key": "₹45 L",
    "hold": 35.0
   }
  ],
  "s6": [
   {
    "s": 35.0,
    "e": 37.15,
    "text": "A ₹1 Cr bakery for ₹45 L",
    "key": "₹45 L",
    "hold": 37.65
   },
   {
    "s": 37.65,
    "e": 38.725,
    "text": "Sounds like a steal",
    "key": "steal",
    "hold": 39.225
   },
   {
    "s": 39.225,
    "e": 40.35,
    "text": "Well, not so fast",
    "key": "fast",
    "hold": 40.8
   }
  ],
  "s7": [
   {
    "s": 40.8,
    "e": 42.6,
    "text": "What if the owner is the head baker",
    "key": "head baker",
    "hold": 43.1
   },
   {
    "s": 43.1,
    "e": 44.15,
    "text": "The moment he leaves,",
    "key": "leaves",
    "hold": 44.275
   },
   {
    "s": 44.275,
    "e": 46.1,
    "text": "you hire someone for ₹6 L a year",
    "key": "₹6 L",
    "hold": 46.55
   }
  ],
  "s8": [
   {
    "s": 46.55,
    "e": 48.675,
    "text": "Now ₹15 L of profit becomes ₹9 L",
    "key": "₹9 L",
    "hold": 49.175
   },
   {
    "s": 49.175,
    "e": 50.25,
    "text": "Same 3 times,",
    "key": null,
    "hold": 50.35
   },
   {
    "s": 50.35,
    "e": 52.725,
    "text": "and your ₹45 L drops to ₹27 L",
    "key": "₹27 L",
    "hold": 53.175
   }
  ],
  "s9": [
   {
    "s": 53.175,
    "e": 54.075,
    "text": "Same bakery",
    "key": null,
    "hold": 54.625
   },
   {
    "s": 54.625,
    "e": 56.075,
    "text": "Same ₹1 Cr in sales",
    "key": "₹1 Cr",
    "hold": 56.55
   },
   {
    "s": 56.55,
    "e": 58.05,
    "text": "A completely different price",
    "key": "price",
    "hold": 58.5
   }
  ],
  "s10": [
   {
    "s": 58.5,
    "e": 60.825,
    "text": "So the real question isn't how much it sells",
    "key": "sells",
    "hold": 61.325
   },
   {
    "s": 61.325,
    "e": 62.475,
    "text": "It's how much it will make",
    "key": "make",
    "hold": 62.6
   },
   {
    "s": 62.6,
    "e": 63.65,
    "text": "after you take over",
    "key": null,
    "hold": 64.1
   }
  ],
  "s11": [
   {
    "s": 64.1,
    "e": 65.025,
    "text": "Save this reel",
    "key": "Save",
    "hold": 65.5
   },
   {
    "s": 65.5,
    "e": 67.725,
    "text": "And if you'd rather buy than build, DM LORE",
    "key": "LORE",
    "hold": 70.925
   }
  ]
 },
